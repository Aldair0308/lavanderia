{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/admin/Dockerfile",
    "buildContext": "."
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"exec node apps/admin/server.mjs\"",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
